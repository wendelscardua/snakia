#!/usr/bin/env ruby
# frozen_string_literal: true

require 'bundler/setup'
require 'find'
require 'pathname'
require 'thor'

# Tool for converting assets into data
class GenerateAssetsData < Thor
  def self.exit_on_failure?
    true
  end

  desc 'generate CPP HEADER INPUT_FOLDER', 'Generates C++ file and header for embedding of assets'
  method_option :starting_bank, type: :numeric, required: true
  method_option :bank_size, type: :numeric, default: 0x4000
  method_option :extensions, type: :array, default: %w[.pal .chr .nam]
  method_option :chr_rom, type: :boolean, default: false
  def generate(cpp_file, h_file, input_folder)
    starting_bank = options[:starting_bank]
    bank_size = options[:bank_size]
    extensions = options[:extensions]
    chr_rom = options[:chr_rom]

    current_bank = starting_bank
    current_bank_size = 0
    assets = {}

    base = Pathname.new(input_folder)

    base.find do |path|
      next if FileTest.directory?(path)

      extension = File.extname(path)

      next unless extensions.include?(extension)

      if chr_rom && extension == '.chr'
        section = '.chr_rom'
      else
        file_size = FileTest.size(path)
        if file_size + current_bank_size > bank_size

          current_bank_size = 0
          current_bank -= 1
          raise 'Bank overflow' if current_bank < -1
        end

        current_bank_size += file_size

        section = ".prg_rom_#{current_bank.negative? ? 'fixed' : current_bank}.rodata.assets"
      end

      file = path.relative_path_from(base).to_s

      assets[section] ||= []
      assets[section] << {
        file:,
        extension:,
        symbol: symbolize(file)
      }
    end

    assets.each_value do |embeds|
      embeds.sort_by! { |embed| "#{embed[:extension]}##{embed[:symbol]}" }
    end

    File.open(cpp_file, 'w') do |f|
      f.puts <<~PREAMBLE
        #include "#{h_file}"
        #define ASSET(symbol) [[gnu::retain]] const char symbol[] =
      PREAMBLE

      assets.each do |section, embeds|
        f.puts <<~PRAGMA

          #pragma clang section rodata = "#{section}"

        PRAGMA

        embeds.each do |embed|
          embed => { file:, symbol: }
          f.puts <<~EMBED
            ASSET(#{symbol}) {
              #embed "#{file}"
            };

          EMBED
        end
      end
    end

    File.open(h_file, 'w') do |f|
      f.puts '#pragma once'
      f.puts 'extern "C" {'
      assets.each_value do |embeds|
        embeds.each do |embed|
          embed => { symbol: }
          f.puts "extern const char #{symbol}[];"
        end
      end
      f.puts '};'
    end
  end

  private

  def symbolize(path)
    path.gsub(/\W/, '_')
  end
end

GenerateAssetsData.start
